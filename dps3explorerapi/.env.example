# Copy to .env and fill in real values:
#   cp .env.example .env

POSTGRES_DATABASE_URI=postgresql://user:password@host:5432/dbname
BUCKET=your-s3-bucket
env=dev

clientId=your-azure-ad-client-id
clientSecret=your-azure-ad-client-secret
tenantId=your-azure-ad-tenant-id
userId=your-default-user-id

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
DB_SCHEMA=datapoem

# Dev only — omit in prod and use an IAM role instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

TRASH_BUCKET=explorer-trash
AUDIT_BUCKET=explorer-trash

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

APPROVAL_BASE_URL=http://localhost:8000/api/v2/explorer
APPROVAL_FRONTEND_URL=http://localhost:3000/explorer
DEACTIVATION_GRACE_DAYS=30
